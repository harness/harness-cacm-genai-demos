# =============================================================
# TRACE_TARGET -- the only switch this app reads to decide where
# spans go.
#   local   (default) -> local-collector/'s Jaeger. No Harness
#                         account, no Harness token needed.
#   harness            -> Harness Cloud & AI Cost Management.
#                         Requires the two Harness values below.
# =============================================================
TRACE_TARGET=local

# -------------------------------------------------------------
# Harness (only read when TRACE_TARGET=harness)
# -------------------------------------------------------------
# Your Harness account identifier. This single value is
# interpolated into every account-bearing field this app sends:
# the x-tenant-id header, the accountIdentifier/routingId query
# params, and the harness.account.id resource attribute. One
# place to get the account ID wrong, not four.
HARNESS_ACCOUNT_ID=

# An ordinary personal/service-account token for that account. The SDK
# sends it natively as the x-harness-service-token header. Never put any
# actual admin/cross-account credential here or anywhere else in this app.
HARNESS_REPORTING_TOKEN=

# Base URL for your account's ingest cluster, no trailing slash.
# See docs/01-get-your-token.md for the cluster-host table.
INGEST_BASE=https://prod3.harness.io/udp-ingest

# -------------------------------------------------------------
# Provider (Google Gen AI, Vertex AI backend)
# -------------------------------------------------------------
# Unlike every other app in 1-harness-sdk/, there is NO API-key
# variable here. Vertex AI authenticates via Application Default
# Credentials (ADC), not a key.
#
# There's no local-Ollama-style zero-cost path for Vertex AI either, so
# this ships pointed at mock-providers/'s stub server by default instead
# -- start it first, in a separate terminal, with:
#   uv run ../../mock-providers/mock_google_genai_server.py
# With GOOGLE_GENAI_BASE_URL set, main.py skips ADC entirely (see its
# STEP 3 comment) -- no `gcloud auth application-default login`, no
# GOOGLE_CLOUD_PROJECT, needed for this path. See mock-providers/README.md
# -- it's a canned response, not real model output, so clear this and set
# up real ADC credentials below once you've confirmed spans show up in
# Jaeger.
GOOGLE_GENAI_BASE_URL=http://localhost:8080

# Only read once GOOGLE_GENAI_BASE_URL above is cleared, for a real
# Vertex AI run. Run this once, in this shell, before `uv run main.py`:
#
#   gcloud auth application-default login
#
# (Or, off your own machine: set GOOGLE_APPLICATION_CREDENTIALS to
# a service-account JSON key file instead. Never commit that file,
# and never put its contents in this .env file.)

# The Google Cloud project ID whose Vertex AI API this app calls.
# Only read once GOOGLE_GENAI_BASE_URL above is cleared.
GOOGLE_CLOUD_PROJECT=

# Any Vertex AI region your project has Gemini access in.
GOOGLE_CLOUD_LOCATION=us-central1

# Cheapest available Gemini model with tool-use support. A full run
# of this demo (three short calls) costs well under $0.01.
GOOGLE_GENAI_MODEL=gemini-2.0-flash

# -------------------------------------------------------------
# Local (only read when TRACE_TARGET=local; ignored otherwise)
# -------------------------------------------------------------
# local-collector/'s Jaeger OTLP/HTTP receiver. Port 4418, not the
# OTel default 4318 -- see local-collector/README.md for why.
LOCAL_OTLP_ENDPOINT=http://localhost:4418
